<?xml version="1.0"?>
<!-- Franka Panda hand. gripper is a geometry-less virtual drive joint carrying the integrated gripper command (-1 open, +1 closed); each finger joint mimics the position its actuator is commanded to, not a measurement. -->
<robot name="panda_hand">
  <link name="base_link"/>
  <link name="drive"/>
  <link name="leftfinger"/>
  <link name="rightfinger"/>
  <joint name="gripper" type="revolute">
    <parent link="base_link"/>
    <child link="drive"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="100" velocity="10"/>
  </joint>
  <joint name="gripper0_right_finger_joint1" type="prismatic">
    <parent link="base_link"/>
    <child link="leftfinger"/>
    <origin xyz="0 0 0.0524" rpy="0 0 1.5707963268"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="100" velocity="10"/>
    <mimic joint="gripper" multiplier="-0.02" offset="0.02"/>
  </joint>
  <joint name="gripper0_right_finger_joint2" type="prismatic">
    <parent link="base_link"/>
    <child link="rightfinger"/>
    <origin xyz="0 0 0.0524" rpy="0 0 1.5707963268"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0" effort="100" velocity="10"/>
    <mimic joint="gripper" multiplier="0.02" offset="-0.02"/>
  </joint>
</robot>
