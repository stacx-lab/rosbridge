<?xml version="1.0"?>
<!-- BiDex-100 Franka FR3v2 seven-joint left arm from MuJoCo left_fr3v2_link0..left_fr3v2_link8; flange is the left_fr3v2_link8 body frame. -->
<robot name="bidex_left_arm">
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="link7"/>
  <link name="flange"/>
  <joint name="left_fr3v2_joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.333" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.7437" upper="2.7437" effort="100" velocity="10"/>
  </joint>
  <joint name="left_fr3v2_joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="-1.5707963268 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7837" upper="1.7837" effort="100" velocity="10"/>
  </joint>
  <joint name="left_fr3v2_joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 -0.316 0" rpy="1.5707963268 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9007" upper="2.9007" effort="100" velocity="10"/>
  </joint>
  <joint name="left_fr3v2_joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.0825 0 0" rpy="1.5707963268 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0421" upper="-0.1518" effort="100" velocity="10"/>
  </joint>
  <joint name="left_fr3v2_joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="-0.0825 0.384 0" rpy="-1.5707963268 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8065" upper="2.8065" effort="100" velocity="10"/>
  </joint>
  <joint name="left_fr3v2_joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0" rpy="1.5707963268 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.5445" upper="4.5169" effort="100" velocity="10"/>
  </joint>
  <joint name="left_fr3v2_joint7" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin xyz="0.088 0 0" rpy="1.5707963268 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0159" upper="3.0159" effort="100" velocity="10"/>
  </joint>
  <joint name="flange_joint" type="fixed">
    <parent link="link7"/>
    <child link="flange"/>
    <origin xyz="0 0 0.107" rpy="0 0 0.785397006691"/>
  </joint>
</robot>
