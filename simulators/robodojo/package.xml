<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosbridge_robodojo</name>
  <version>0.2.0</version>
  <description>RoboDojo simulator (Isaac Sim 5.1, dual ARX X5) as a ROS 2 node with a native worker.</description>
  <maintainer email="haitongma8@gmail.com">haitongma</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rosbridge_runtime</exec_depend>
  <exec_depend>kinex_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
