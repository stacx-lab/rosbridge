+class BladeCutCondition(RuleCondition):
+    """
+    Rule condition that prunes object candidates from @filter_name, only keeping any that a slicer cuts, and prunes
+    the "slicer" candidates, only keeping the slicers that cut them. A slicer cuts an object if the slicer is active,
+    it is touching the object, and its blade reaches the object: the object's collision shapes overlap the volume of
+    the slicer's blade meta link (m.SLICER_META_LINK_TYPE), grown by m.SLICER_BLADE_MARGIN on every side. A slicer
+    without a blade meta link cuts with its whole body.
+    """
+
+    def __init__(self, filter_name):
+        """
+        Args:
+            filter_name (str): Name of the filter whose object candidates will be pruned based on whether or not
+                a slicer cuts them
+        """
+        self._filter_name = filter_name
+        # Maps slicer to its blade volumes, each a box: (meta link, the box's pose in the link's frame, half extent)
+        self._blades = dict()
+
+    def refresh(self, object_candidates):
+        # The slicers may have changed
+        self._blades = dict()
+
+    def _blade_hits(self, slicer):
+        """
+        Args:
+            slicer (StatefulObject): Slicer whose blade should be checked
+
+        Returns:
+            None or set of str: Prim paths of the rigid bodies whose collision shapes the blade of @slicer reaches,
+                or None if @slicer has no blade meta link
+        """
+        if slicer not in self._blades:
+            self._blades[slicer] = []
+            for link in slicer.links.values():
+                if not link.is_meta_link or link.meta_link_type != m.SLICER_META_LINK_TYPE:
+                    continue
+                # A meta link's meshes do not move within it: their boxes are computed once, in its frame
+                link_pose = T.pose2mat(get_world_pose(link.prim_path))
+                for mesh in link.visual_meshes.values():
+                    lower, upper = mesh.points.min(dim=0).values, mesh.points.max(dim=0).values
+                    box_pose = th.linalg.inv(link_pose) @ mesh.scaled_transform
+                    box_pose[:3, 3] += box_pose[:3, :3] @ ((upper + lower) / 2.0)
+                    scale = th.linalg.norm(box_pose[:3, :3], dim=0)
+                    box_pose[:3, :3] /= scale
+                    if th.linalg.det(box_pose[:3, :3]) < 0:
+                        # A mirrored box is the same box
+                        box_pose[:3, 2] = -box_pose[:3, 2]
+                    self._blades[slicer].append((link, box_pose, (upper - lower) / 2.0 * scale))
+        if len(self._blades[slicer]) == 0:
+            return None
+
+        hits = set()
+
+        def overlap_callback(hit):
+            hits.add(hit.rigid_body)
+            # Continue traversal: every body the blade reaches counts
+            return True
+
+        for link, box_pose, half_extent in self._blades[slicer]:
+            # The box where its meta link is now: the meta link moves with the link it is fixed to
+            pose = T.pose2mat(link.get_position_orientation()) @ box_pose
+            og.sim.psqi.overlap_box(
+                halfExtent=(half_extent + m.SLICER_BLADE_MARGIN).tolist(),
+                pos=pose[:3, 3].tolist(),
+                rot=T.mat2quat(pose[:3, :3]).tolist(),
+                reportFn=overlap_callback,
+            )
+        return hits
+
+    def __call__(self, object_candidates):
+        active_slicers = [obj for obj in object_candidates["slicer"] if obj.states[SlicerActive].get_value()]
+        objs, slicers, blade_hits = [], [], dict()
+
+        def touching(obj, with_set):
+            return RigidContactAPI.is_in_contact(
+                scene_idx=obj.scene.idx, query_set=[obj], with_set=with_set, ignore_set=None, current_only=False
+            )
+
+        for obj in object_candidates[self._filter_name]:
+            if len(active_slicers) == 0 or not touching(obj, active_slicers):
+                continue
+            # The first active slicer that touches the object and reaches it with its blade cuts it
+            for slicer in active_slicers:
+                if len(active_slicers) > 1 and not touching(obj, [slicer]):
+                    continue
+                if slicer not in blade_hits:
+                    blade_hits[slicer] = self._blade_hits(slicer)
+                if blade_hits[slicer] is None or any(
+                    link.prim_path in blade_hits[slicer] for link in obj.links.values()
+                ):
+                    objs.append(obj)
+                    if slicer not in slicers:
+                        slicers.append(slicer)
+                    break
+
+        # Update candidates
+        object_candidates[self._filter_name] = objs
+        object_candidates["slicer"] = slicers
+
+        # If objs is empty, return False, otherwise, True
+        return len(objs) > 0
+
+    @property
+    def modifies_filter_names(self):
+        return {self._filter_name, "slicer"}
+
