+    def set_metric_command(self, velocity, height, torso_rpy):
+        """Opt-in metric command path for simulation-owned device control.
+
+        Call before set_observation so this interval's command enters history.
+        The legacy heading/turn-flag path remains unchanged when not selected.
+        """
+        velocity = np.asarray(velocity, dtype=float)
+        torso_rpy = np.asarray(torso_rpy, dtype=float)
+        if velocity.shape != (3,) or torso_rpy.shape != (3,):
+            raise ValueError("Expected three velocity and torso components")
+        if not np.isfinite(np.r_[velocity, height, torso_rpy]).all():
+            raise ValueError("Metric command must be finite")
+        self.metric_velocity = velocity.copy()
+        self.cmd[:3] = velocity
+        self.height_cmd = float(height)
+        self.roll_cmd, self.pitch_cmd, self.yaw_cmd = torso_rpy
